<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.airtagcat.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/var/mobile/airtagcat/controller.py</string>
        <string>--server</string>
        <string>--local</string>
    </array>

    <!-- Relaunch automatically if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Wait for networking before starting -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/mobile/airtagcat/daemon.log</string>

    <key>StandardErrorPath</key>
    <string>/var/mobile/airtagcat/daemon.log</string>
</dict>
</plist>
